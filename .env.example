NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_PASSWORD=your_secure_admin_password

# Auth (Supabase Dashboard):
# 1. Run migrations:
#    supabase/migrations/007_user_owned_events.sql
#    supabase/migrations/008_user_owned_academies.sql
#    supabase/migrations/009_academy_social_links.sql
# 2. Authentication → Sign In / Providers → Email (enabled) + Google (Client ID/Secret)
# 3. Google Cloud redirect URI (NOT your site):
#    https://<project-ref>.supabase.co/auth/v1/callback
# 4. Authentication → URL Configuration (critical for Google redirect):
#    Site URL: https://wolnamata.pl
#    Redirect URLs (add ALL of these):
#      https://wolnamata.pl/auth/callback
#      https://wolnamata.pl/**
#      http://localhost:3000/auth/callback
#      http://localhost:3000/**
