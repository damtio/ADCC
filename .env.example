NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_PASSWORD=your_secure_admin_password

# Auth (Supabase Dashboard):
# 1. Run migration supabase/migrations/007_user_owned_events.sql
# 2. Authentication → Providers → Email (enabled)
# 3. Authentication → Providers → Google (optional):
#    - Create OAuth client in Google Cloud Console
#    - Add Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#    - Paste Client ID + Secret into Supabase Google provider
# 4. Authentication → URL Configuration:
#    - Site URL: https://wolnamata.pl (or http://localhost:3000 locally)
#    - Redirect URLs: http://localhost:3000/auth/callback, https://wolnamata.pl/auth/callback
